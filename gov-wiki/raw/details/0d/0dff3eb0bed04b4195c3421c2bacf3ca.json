    "faqList": [
      {
        "createDate": 1626426969000,
        "faqContent": "发行进口出版物从哪进货？",
        "faqId": "6e67b548613a462a88f61b84d7c857c9",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "根据《出版管理条例》第四十七条、《出版物市场管理规定》第二十二条规定：发行进口出版物的，必须从依法设立的出版物进口经营单位进货",
        "unifyId": "0dff3eb0bed04b4195c3421c2bacf3ca",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626426969000,
        "faqContent": "拟进口经营的出版物目录备案材料已提供审读报告，是不可以不提供样书？",
        "faqId": "f3e53d05930746088b98052ed4df748d",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 2.0,
        "replyContent": "必须提供。如不提供，无法对拟进口的出版物合法性进行审查。",
        "unifyId": "0dff3eb0bed04b4195c3421c2bacf3ca",
        "updateDate": 1668659564000
      }
