    "faqList": [
      {
        "createDate": 1709788286000,
        "faqContent": "未取得电影公映许可证的影片是否可以赴境外参展",
        "faqId": "bbf77527e0344600960d9f47be62f1ce",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 1.0,
        "replyContent": "否。《中华人民共和国电影产业促进法》第二十一条规定：摄制完成的电影取得电影公映许可证，方可参加电影节（展）。拟参加境外电影节（展）的，送展法人、其他组织应当在该境外电影节（展）举办前，将相关材料报国务院电影主管部门或者省、自治区、直辖市人民政府电影主管部门备案。",
        "unifyId": "7UFbl16YTi6t3zA7WQcvkg",
        "updateDate": 1725590723000
      },
      {
        "createDate": 1709788346000,
        "faqContent": "已取得电影公映许可证的电影需要变更内容的，还要重新报送审查吗？",
        "faqId": "e09db2f911554486a9e1b67229392297",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 2.0,
        "replyContent": "《中华人民共和国电影产业促进法》第十九条规定：取得电影公映许可证的电影需要变更内容的，应当依照本法规定重新报送审查。",
        "unifyId": "7UFbl16YTi6t3zA7WQcvkg",
        "updateDate": 1725590728000
      }
    ],
