        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 2.0,
        "replyContent": "根据属地管理原则，申请单位应到实际经营地址所在区县相关部门申请办理。同时根据办理条件的要求。申请单位注册地址与实际经营地址必须一致。",
        "unifyId": "b476af8ebf8647a1b8ce656b51db93a9",
        "updateDate": 1668659564000
