    "faqList": [
      {
        "createDate": 1627261093000,
        "faqContent": "《核准目录》是一直不变的吗？",
        "faqId": "60fc62923b1840379114d69c81675644",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 1.0,
        "replyContent": "不是，会根据国家政策、法律法规等不定期调整《核准目录》。",
        "unifyId": "7d4541ca885d430e97408f73d3f0b550",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1627261093000,
        "faqContent": "核准批复文件是否有时效性？",
        "faqId": "ffe1193fb64a450ea1869a1b97fda89a",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 2.0,
        "replyContent": "项目核准文件有效期为自项目核准机关做出予以核准决定或者同意变更决定之日起2年。2年内未开工建设，需要延期开工建设的，企业应当在2年期限届满的30个工作日前，向核准机关申请延期开工建设。核准机关应当自受理申请之日起20个工作日内，做出是否同意延期开工建设的决定。开工建设只能延期一次，期限最长不得超过1年。在有效期内未开工建设也未按照规定向原项目核准机关申请延期的，原项目核准文件自动失效。",
        "unifyId": "7d4541ca885d430e97408f73d3f0b550",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1627261093000,
        "faqContent": "住房建设项目是属于核准类还是备案类？",
        "faqId": "6385455167854494beb7887ef932593e",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 3.0,
        "replyContent": "在《核准目录》范围内的项目属于核准类，《核准目录》以外的项目为备案类项目。请根据现行有效的《核准目录》查询住房建设项目是否在该目录范围内来判断。",
        "unifyId": "7d4541ca885d430e97408f73d3f0b550",
        "updateDate": 1668659564000
      }
