    "faqList": [
      {
        "createDate": 1761810541000,
        "faqContent": "禁止性规定是什么",
        "faqId": "wzmKjXCFR_21egfCdsfSiQ",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "（一）机动车所有人提交的证明、凭证无效的； （二）机动车来历证明被涂改或者机动车来历证明记载的机动车所有人与身份证明不符的； （三）机动车所有人提交的证明、凭证与机动车不符的； （四）机动车未经国务院机动车产品主管部门许可生产或者未经国家进口机动车主管部门许可进口的；（五）机动车的有关技术数据与国务院机动车产品主管部门公告的数据不符的； （六）机动车车辆识别代码或者有关参数不符合国家安全技术标准的； （七）机动车达到国家规定的强制报废标准的； （八）机动车被监察机关、人民法院、人民检察院、行政执法部门依法查封、扣押的； （九）机动车属于被盗抢骗的； （十）其他不符合法律、行政法规规定的情形。",
        "unifyId": "fPyRqx54QNKavrilv726eg",
        "updateDate": 1761810541000
      }
    ],
