    "faqList": [
      {
        "createDate": 1626163370000,
        "faqContent": "拍卖企业是先照后证吗？",
        "faqId": "092067c52f9444bdb2e34bcce4a08637",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "答：拍卖企业的设立是先在市场监督管理局取得营业执照后，再到商务部门来办理相关手续，依法取得从事拍卖业务许可。",
        "unifyId": "43adf051d40f4011872cc8baab212eb5",
        "updateDate": 1668659564000
      }
    ],
