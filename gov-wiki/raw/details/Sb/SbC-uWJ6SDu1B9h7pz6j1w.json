    "faqList": [
      {
        "createDate": 1626765395000,
        "faqContent": "如何领取快递业务经营许可证？",
        "faqId": "O8WeAQgUQf-O_bZgZLX0lQ",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "许可审批核准之后，领取人应带上公司开具的委托书、领取人身份证复印件、申请材料纸质版全套（加盖公章）到发证机关现场领取证书。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765409000,
        "faqContent": "申请许可时，如何查询邮政管理部门的联系方式？",
        "faqId": "PK8C2ORXTfOwVZL1PheCBw",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 2.0,
        "replyContent": "登录国家邮政局政务服务门户（https://zwfw.spb.gov.cn/），在“行政许可”中选择“快递业务经营许可”，接着选择“办事指南”，联系方式中有国家邮政局及各省邮政管理局的联系地址和联系电话。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765424000,
        "faqContent": "股权结构中，工商注册号或统一社会信用代码（自然人身份证号）如何填写？",
        "faqId": "4EDmSFSURae0NfaCDFJ-_A",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 3.0,
        "replyContent": "若股东为公司，请填写公司的工商注册号（统一社会信用代码）。若股东为自然人，请填写身份证件号码。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765436000,
        "faqContent": "企业法定代表人是港澳台居民或外国公民，如何填写证件号码？",
        "faqId": "RLEy4aLLQzuXMxwweQVxrg",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 4.0,
        "replyContent": "证件号码可填写护照等有效身份证件号码。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765447000,
        "faqContent": "经营许可申请书如何打印？",
        "faqId": "DGxKQ2xUTVqFbGANh-3Y_w",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 5.0,
        "replyContent": "点击企业许可申请书，右上角有预览打印，打印之前请安装打印控件(需使用IE8或IE9浏览器)。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765459000,
        "faqContent": "许可申请时，填写信息和材料是有特定的顺序吗？",
        "faqId": "ja6shoeRRTmlQqjbpUatEg",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 6.0,
        "replyContent": "许可申请时，请根据许可申请书、股权结构、分公司(营业部名录)、子公司名录、加盟企业名录、材料清单顺序填写。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765469000,
        "faqContent": "申请许可的企业名称可带有XX分公司吗？",
        "faqId": "3p2wXnifQCaSDn63_xgkpg",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 7.0,
        "replyContent": "申请许可的企业名称中不可含有XX分公司、XX营业部或者XX网点。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765482000,
        "faqContent": "企业注册后发现企业名称有错别字怎么办？",
        "faqId": "0l2LmIFkQNyXutbb0owXrQ",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 8.0,
        "replyContent": "未获得许可之前企业注册的名称无法更改，可使用正确的名称重新注册账号。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765492000,
        "faqContent": "如何查询申请进度？",
        "faqId": "r2onFeLORvaK08n9Br0umQ",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 9.0,
        "replyContent": "登录国家邮政局政务服务门户（https://zwfw.spb.gov.cn/），用户登录之后可在“用户中心”中选择“我的办件”，查看具体进度及审核意见。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765504000,
        "faqContent": "如何查询申请的相关要求？",
        "faqId": "Cl4N3UBmTDSMXkDdwoeplA",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 10.0,
        "replyContent": "登录国家邮政局政务服务门户（https://zwfw.spb.gov.cn/），在“行政许可”中选择“快递业务经营许可”，接着选择“办事指南”，就可以查到许可申请的相关规定和要求。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626765515000,
        "faqContent": "申请跨省、自治区、直辖市经营快递业务许可或经营国际快递业务许可时，邮政管理部门的业务咨询电话和咨询时间是什么？",
        "faqId": "21t1MUQoT-6XLszh1NCi-Q",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 11.0,
        "replyContent": "业务咨询电话：010-88323114/3247，咨询时间：周一至周四13：30-16：30。为保障企业商业秘密和通讯安全，如实记录申请人信用情况，请在国家政务服务平台或者国家邮政局政务服务门户以身份证、普通护照、港澳居民来往内地通行证、台湾居民来往大陆通行证等有效身份证件实名注册的企业法定代表人或经办人，以在上述系统依法登记的电话号码拨打咨询电话。遇有登记的电话号码调整，请联系信息技术人员13912997301、15952090332、15236656306。",
        "unifyId": "SbC-uWJ6SDu1B9h7pz6j1w",
