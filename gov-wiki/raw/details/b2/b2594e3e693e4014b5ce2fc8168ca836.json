      },
      {
        "createDate": 1624511326000,
        "faqContent": "申请点播院线筹建证需要哪些材料",
        "faqId": "ieMp8vE8S9iy5WtRjcVrtg",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 4.0,
        "replyContent": "1.点播院线筹建申请表；2.营业执照和法人身份证复印件；3.点播院线计费系统标准符合性证明文件；4.具有电影公映许可证的影片的放映授权证明文件；5.授权办理委托书（不是法人申请时需提供）",
        "unifyId": "b2594e3e693e4014b5ce2fc8168ca836",
        "updateDate": 1668659564000
      }
