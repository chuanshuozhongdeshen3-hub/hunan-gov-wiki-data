    "faqList": [
      {
        "createDate": 1760762545000,
        "faqContent": "禁止性规定是什么？",
        "faqId": "5df2c6d368b34392b8c76a7da71238ad",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "（（一）改变机动车的品牌、型号和发动机型号的，但经国务院机动车产品主管部门许可选装的发动机除外；\n（二）改变已登记的机动车外形和有关技术数据的，但法律、法规和国家强制性标准另有规定的除外；\n（三）机动车所有人提交的证明、凭证无效的；\n（四）机动车达到国家规定的强制报废标准的；\n（五）机动车被人民法院、人民检察院、行政执法部门依法查封、扣押的；\n（六）机动车属于被盗抢的规定情形的； \n（七）办理机动车所有人的住所迁出或者迁入车辆管理所管辖区域的业务，该车的道路交通安全违法行为和交通事故未处理完毕的。",
        "unifyId": "Twe7KdwiTOqhmQedEuAWUg",
        "updateDate": 1761813783000
      }
