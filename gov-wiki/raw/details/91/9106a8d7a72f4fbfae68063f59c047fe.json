    "faqList": [
      {
        "createDate": 1689152855000,
        "faqContent": "民办非企业单位成立登记需提供哪些材料？",
        "faqId": "KaV144KLRUCc2Z1CGqCnjA",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "提供基础材料如下：\n1、民办非企业单位登记事项表\n2、发起人/发起单位资质简介及相关证明材料\n3、验资报告\n4、住所证明\n5、捐资承诺书\n6、党政领导干部兼职审批表\n7、经营资质前置审批材料\n8、法律法规要求提供的其他材料",
        "unifyId": "9106a8d7a72f4fbfae68063f59c047fe",
