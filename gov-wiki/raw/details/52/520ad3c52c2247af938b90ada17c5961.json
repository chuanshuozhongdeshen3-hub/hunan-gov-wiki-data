    "faqList": [
      {
        "createDate": 1624860907000,
        "faqContent": "什么是监控化学品？",
        "faqId": "76d52e63f8a14ff88b06cceba5afa283",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "根据《各类监控化学品名录》（化工部令1996年第11号）规定，监控化学品包括了第一类、第二类、第三类和第四类监控化学品，其中第四类监控化学品涵盖了除炸药和纯碳氢化合物以外的特定有机化学品，包括了除碳的氧化物、硫化物和金属碳酸盐以外的所有碳化合物所组成的化合物族类的任何化学品。根据其定义，第四类监控化学品基本涵盖了通过化学反应生成的有机化合物。",
        "unifyId": "520ad3c52c2247af938b90ada17c5961",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1624860907000,
        "faqContent": "变质或者过期失效情况如何界定？",
        "faqId": "8fee09a9497a4fecb8464efd49faafc9",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 2.0,
        "replyContent": "当上述所指的所有监控化学品超过其所属产品标准的有效期或产品质量不符合标准时，就可判定该监控化学品为变质或者过期失效。",
        "unifyId": "520ad3c52c2247af938b90ada17c5961",
        "updateDate": 1668659564000
      }
    ],
