{
  "code": 0,
  "data": {
    "acceptanceCondition": "运输剧毒化学品的车辆需要上道路通行的",
    "according": "《危险化学品安全管理条例》（2002年1月26日国务院令第344号，2013年12月7日予以修改）第六条第二项：公安机关负责危险化学品的公共安全管理，核发剧毒化学品购买许可证、剧毒化学品道路运输通行证，并负责危险化学品运输车辆的道路交通安全管理。\n第五十条：通过道路运输剧毒化学品的，托运人应当向运输始发地或者目的地县级人民政府公安机关申请剧毒化学品道路运输通行证。……县级人民政府公安机关应当自收到前款规定的材料之日起7日内，作出批准或者不予批准的决定。予以批准的，颁发剧毒化学品道路运输通行证；不予批准的，书面通知申请人并说明理由。",
    "applicantDuty": "应当如实向行政机关提交有关材料和反映真实情况，并对其申请材料实质内容的真实性负责。",
    "applicantPower": "依法享有知情权、陈述权、申辩权，有权依法申请行政复议或者提起行政诉讼。",
    "approveLimit": "7",
    "approveLimitExplain": "根据《危险化学品安全管理条例》《剧毒化学品购买和公路运输许可证件管理办法》",
    "blbm": "县级公安部门",
    "commitmentLimit": "7",
    "commitmentLimitExplain": "根据《危险化学品安全管理条例》《剧毒化学品购买和公路运输许可证件管理办法》",
    "deptName": "公安部门",
    "doScope": "全国",
    "faqList": [
      {
        "createDate": 1668498435000,
        "faqContent": "禁止性规定",
        "faqId": "3abeb48f84f64f908b59e071d7fed0ad",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 1.0,
        "replyContent": "（一）以个人名义提出申请的； （二）证明文件过期或者失效的； （三）证明文件与全省剧毒化学品道路运输数据库记录比对结果不一致或者没有记录的； （四）承运单位不具备运输危险化学品资质的； （五）驾驶人、押运人员不具备上岗资格的； （六）驾驶人在一个记分周期内有交通违法计满12分情形，或有两次以上驾驶剧毒化学品运输车辆超载、超速记录的； （七）车辆有非法改装行为或者安全状况不符合国家安全技术标准的； （八）其它违反国家相关法律法规情形的； （九）申请单位未向所在地的县级公安机关交通管理部门备案。",
        "unifyId": "NOrFXfBpR_GmwJv0surAbQ",
        "updateDate": 1668659564000
      }
