    "deptName": "民政部门",
    "doScope": "全省",
    "faqList": [
      {
        "createDate": 1628149571000,
        "faqContent": "募捐人通过哪些方式开展募捐活动？",
        "faqId": "8f5a78fcceb94ca9ab4f312db17d3783",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "(一)通过广播、电视、报刊、网站等媒体劝募;\n\n(二)在公共场所摆放募捐箱;\n\n(三)两名以上的工作人员持募捐人有效证件劝募;\n\n(四)寄发劝募函或者发送劝募信息;\n\n(五)义演、义赛、义卖、义拍;\n\n(六)其他适当方式。",
        "unifyId": "4d701a387f354699becf1fc0ca65ca5f",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1628149571000,
        "faqContent": "募捐许可应具备哪些条件？",
        "faqId": "f6910c556dae47a28f760fbc181ec9b2",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 2.0,
        "replyContent": "(一)有开展募捐、进行公益活动的人员、场地等条件;\n\n(二)财务会计制度和信息公开制度合法、规范、有效;\n\n(三)法律、法规规定的其他条件。",
        "unifyId": "4d701a387f354699becf1fc0ca65ca5f",
        "updateDate": 1668659564000
      }
    ],
