    "doScope": "全省",
    "faqList": [
      {
        "createDate": 1626863982000,
        "faqContent": "对检测报告有哪些具体要求？",
        "faqId": "ee70eff621af4bf5a023bdf01bf87d10",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 1.0,
        "replyContent": "1.要求提交一年以内的检测报告；2.检测机构具备相应资质；3.所检指标符合相关标准要求。",
        "unifyId": "36f729d9f9214c348753048f3cf63003",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626863982000,
        "faqContent": "申请办理《放射诊疗许可证》时，哪些设备需要提交大型设备配置许可证明材料?",
        "faqId": "6c51441847fb470f968ed26a23f6d4c4",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 2.0,
        "replyContent": "根据《国务院关于修改<医疗器械监督管理条例>的决定》（国务院令第680号），医疗器械使用单位配置大型医用设备，应经省级以上人民政府卫生计生主管部门批准，取得大型医用设备配置许可证。具体设备目录按照《国家卫生健康委员会关于发布大型医用设备配置许可管理目录（2018年）的通知》（国卫规划发〔2018〕5号）执行。",
        "unifyId": "36f729d9f9214c348753048f3cf63003",
        "updateDate": 1668659564000
      },
      {
        "createDate": 1626863982000,
        "faqContent": "放射工作人员每年都要参加放射防护和有关法律知识培训吗？",
        "faqId": "14a987690ee5436dba8cfdfa32636d3e",
        "isDelete": "N",
        "isSzyy": "N",
        "orderNum": 3.0,
        "replyContent": "放射工作人员两次培训的时间间隔不超过2年，每次培训时间不少于2天。",
        "unifyId": "36f729d9f9214c348753048f3cf63003",
        "updateDate": 1668659564000
      }
    ],
