    "faqList": [
      {
        "createDate": 1627007185000,
        "faqContent": "可行性研究报告的编制有哪些要求？",
        "faqId": "eec8532bff51416da86cf4ee9b2d14ba",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 1.0,
        "replyContent": "可行性研究报告可以由项目单位自行编制，或委托工程咨询单位编制，国家或省另有规定的除外。项目可行性研究报告应对项目在技术和经济上的可行性以及社会效益、节能、资源综合利用、生态环境影响、社会稳定风险等进行全面分析论证，落实各项建设和运行保障条件。",
        "unifyId": "8b404493576d442cb65c9addc04210b8",
        "updateDate": 1668659564000
      }
