    "faqList": [
      {
        "createDate": 1629364705000,
        "faqContent": "办理宗教临时活动地点审批的程序是什么？",
        "faqId": "09b701fdc429441e99534bf778982b9a",
        "isDelete": "N",
        "isSzyy": "Y",
        "orderNum": 1.0,
        "replyContent": "信教公民有进行经常性集体宗教活动需要，尚不具备条件申请设立宗教活动场所的，由信教公民代表向县级人民政府宗教事务部门提出申请，县级人民政府宗教事务部门征求所在地宗教团体和乡级人民政府意见后，可以为其指定临时活动地点。\n\n在县级人民政府宗教事务部门指导下，所在地乡级人民政府对临时活动地点的活动进行监管。具备设立宗教活动场所条件后，办理宗教活动场所设立审批和登记手续。\n\n临时活动地点的宗教活动应当符合本条例的相关规定。",
        "unifyId": "8bbe7ef370df4938a7e1e04745918f4f",
        "updateDate": 1668659564000
      }
    ],
